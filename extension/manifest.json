{
  "manifest_version": 3,
  "name": "MessScrap",
  "version": "0.2.1",
  "description": "Facebook Messenger Chat Exporter — JSON and TXT",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "MessScrap",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "messscrap@refil.cc",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
