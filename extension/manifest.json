{
  "manifest_version": 3,
  "name": "MessScrap",
  "version": "2.0.1",
  "description": "Archive Messenger conversations, attachments, and statistics to your device.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "MessScrap",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "messscrap@refil.cc",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "storage.js"
    ]
  }
}
